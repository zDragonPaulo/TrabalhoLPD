\contentsline {figure}{\numberline {2}{\ignorespaces Exemplo de um DoS Attack, onde o atacante envia uma grande quantidade de tráfego para o alvo, sobrecarregando o sistema alvo}}{3}{figure.caption.8}%
\contentsline {figure}{\numberline {3}{\ignorespaces Exemplo de um Syn Flood Attack, onde o atacante envia uma grande quantidade de pacotes SYN para o alvo, sem completar o handshake, sobrecarregando o sistema alvo}}{4}{figure.caption.9}%
\contentsline {figure}{\numberline {4}{\ignorespaces Exemplo de Port Knocking, onde o cliente envia uma sequência específica de pacotes para portas fechadas em um sistema, e quando a sequência correta é recebida, o sistema adiciona o endereço IP do remetente a uma lista de permissões temporária, permitindo o acesso ao dispositivo}}{4}{figure.caption.10}%
